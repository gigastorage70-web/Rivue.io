{
  "manifest_version": 3,
  "name": "Rivue — SEO & Competitor Intelligence",
  "version": "1.0.0",
  "description": "All-in-one SEO, competitor intelligence, PR, and growth platform delivered directly in your browser.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rivue SEO Quick Pulse"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
