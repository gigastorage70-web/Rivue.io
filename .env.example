# =============================================================================
# RIVUE — Environment Configuration Template (.env.example)
# Production Grade Live-Data Standard (§8 Deployment Readiness)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Cloudflare D1 SQLite Configuration
# -----------------------------------------------------------------------------
# For Cloudflare Cloud D1 access over HTTPS REST API or Workers binding:
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_D1_DATABASE_ID="your_d1_database_uuid_here"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_with_d1_edit_permissions"

# Local SQLite storage path (used when credentials are not set or in offline dev):
D1_SQLITE_PATH="./.d1/rivue-d1.sqlite"
D1_PREFER_LOCAL="false"

# -----------------------------------------------------------------------------
# 2. External SERP & Crawler Pipeline
# -----------------------------------------------------------------------------
# Serper.dev API key for live Google SERP, News, Places, and Autocomplete:
SERPER_API_KEY="your_serper_api_key_here"

# -----------------------------------------------------------------------------
# 3. Live-Data Standard & Anti-Mock Flags (§4 & §8)
# -----------------------------------------------------------------------------
# Set to 'true' ONLY during offline component development or isolated unit tests.
# CRITICAL: If set to 'true' in a production build, the build will hard-fail.
USE_MOCK_DATA="false"

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV="development"

# Web App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
